{
  "manifest_version": 3,
  "name": "BIDit: Live card auctions on Pump.fun",
  "version": "1.1.0",
  "description": "Bid on live trading-card auctions right on Pump.fun streams. Settle in USDC, held in escrow until it ships.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://bidit-backend-fekn.onrender.com/*",
    "https://pump.fun/*",
    "https://*.pump.fun/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://pump.fun/*", "https://*.pump.fun/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BIDit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
